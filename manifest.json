{
  "manifest_version": 3,
  "name": "CrediClean",
  "version": "0.5.0",
  "description": "Inspect and remove supported Content Credentials from AI-generated images in ChatGPT, Gemini and Grok.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://assets.grok.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.oaiusercontent.com/*",
    "https://pbs.twimg.com/*",
    "https://usercontent.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/content/network-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "CrediClean",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/image-detector.js",
        "src/content/overlay.js",
        "src/content/button-manager.js",
        "src/content/content.css",
        "src/processing/image-loader.js",
        "src/processing/metadata-inspector.js",
        "src/processing/credential-processor.js",
        "src/processing/download-manager.js",
        "src/formats/detect.js",
        "src/formats/png.js",
        "src/formats/jpeg.js",
        "src/formats/webp.js",
        "src/formats/jumbf.js",
        "src/shared/constants.js",
        "src/shared/messages.js",
        "src/shared/settings.js",
        "src/platforms/index.js",
        "src/platforms/base.js",
        "src/platforms/chatgpt.js",
        "src/platforms/gemini.js",
        "src/platforms/grok.js",
        "src/content/observed-sources.js",
        "src/content/route-watcher.js"
      ],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/*"
      ]
    }
  ]
}
